{
  "name": "database-academy",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "inventory": "python scripts/import-content/inventory.py",
    "sql:assets": "node scripts/build-sql-assets.mjs",
    "predev": "npm run sql:assets && npm run exam:catalog",
    "prebuild": "npm run sql:assets && npm run exam:catalog",
    "sql:convert": "python scripts/import-content/convert_sql.py",
    "test:sql-import": "python tests/sql_import_test.py",
    "algebra:datasets": "python scripts/import-content/build_algebra_data.py",
    "exam:catalog": "node scripts/build-exam-catalog.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "^6.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "katex": "$katex",
    "dompurify": "3.4.17"
  }
}
