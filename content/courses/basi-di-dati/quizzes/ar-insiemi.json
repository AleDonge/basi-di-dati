      "prompt": "Quale operazione restituisce gli elementi di R assenti da S?",
      "concepts": [
        "unione",
        "intersezione",
        "differenza"
      ],
      "sourceRefs": [
        {
          "sourceId": "algebra-source",
          "file": "Argomento03 Algebra Relazionale.pdf",
          "pageStart": 21,
          "pageEnd": 25,
          "section": "Unione, intersezione e differenza"
        }
      ],
      "options": [
        {
          "id": "errata",
          "text": "L’intersezione R ∩ S."
        },
        {
          "id": "corretta",
          "text": "La differenza R − S."
        }
      ],
      "correctOptionIds": [
        "corretta"
      ],
      "explanation": "R−S conserva chi appartiene a R e non a S. L’intersezione conserva invece soltanto chi appartiene a entrambi."
    },
