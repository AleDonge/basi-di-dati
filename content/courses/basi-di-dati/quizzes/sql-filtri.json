      ],
      "options": [
        {
          "id": "opzione-1",
          "text": "age = NULL"
        },
        {
          "id": "opzione-2",
          "text": "age IS NULL"
        },
        {
          "id": "opzione-3",
          "text": "age = 0"
        }
